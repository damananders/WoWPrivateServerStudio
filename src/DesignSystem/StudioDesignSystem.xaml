<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- the suite's token names and values (AndersCraft colours): Tokens.xaml. This file's own keys come first where both exist. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Studio.DesignSystem;component/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!--
      STUDIO DESIGN SYSTEM
      Shared look for the DaManAnders studio apps (this copy carries the AndersCraft palette: #141113 / #1B1618, maroon #8E2B3A, amber #F0B46A). Rules of thumb:
      - Separate areas with tone (Surface0 → Surface3), space and soft elevation, not lines.
      - Dividers are rare and faint (Divider brush). Lists have no row lines: hover highlight instead.
      - Corners 12–16 (cards), 22–26 (hero / floating panels), pills for actions and chips.
      - One hero per screen; mixed card sizes (bento), never an equal grid of boxes.
      - Motion: Motion.Fast / Motion.Medium; StudioLook.Apply sets them to 0 when Windows asks for reduced motion.
      - Keep text contrast ≥ 4.5:1 on every surface (checked for Text and Muted on Surface0–3).
    -->

    <!-- ===== tokens ===== -->
    <CornerRadius x:Key="Radius.Small">12</CornerRadius>
    <!-- §1 layers: translucent white over the page colour -->
    <SolidColorBrush x:Key="Layer5" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Layer10" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Layer15" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Layer20" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Layer40" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TextStrong" Color="#F3E9E4"/>

    <!-- §2 bleed fills and feather masks -->
    <LinearGradientBrush x:Key="Fill.Bleed" StartPoint="0,0.38" EndPoint="1,0.62">
        <GradientStop Color="#14FFFFFF" Offset="0"/><GradientStop Color="#06FFFFFF" Offset="0.48"/><GradientStop Color="#00FFFFFF" Offset="0.88"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.BleedHover" StartPoint="0,0.38" EndPoint="1,0.62">
        <GradientStop Color="#24FFFFFF" Offset="0"/><GradientStop Color="#10FFFFFF" Offset="0.55"/><GradientStop Color="#03FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.Row" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#12FFFFFF" Offset="0"/><GradientStop Color="#05FFFFFF" Offset="0.6"/><GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.RowHover" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#26FFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="0.7"/><GradientStop Color="#02FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Mask.Feather" Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.675" RadiusY="0.625">
        <GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.58"/><GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Mask.FadeDown" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.62"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Mask.FadeRight" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.7"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- §5 two-hue accents -->
    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8E2B3A" Offset="0"/><GradientStop Color="#A8463A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Amber.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0B46A" Offset="0"/><GradientStop Color="#F6C687" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Go.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B8549" Offset="0"/><GradientStop Color="#3BAF67" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="Glow.AmberColor">#F0B46A</Color>
    <Color x:Key="Glow.MaroonColor">#B23A4C</Color>
    <SolidColorBrush x:Key="Diff.Add" Color="#3322A04A"/>
    <SolidColorBrush x:Key="Diff.Del" Color="#33E0485A"/>
    <SolidColorBrush x:Key="Diff.ChgOld" Color="#26E0485A"/>
    <SolidColorBrush x:Key="Diff.ChgNew" Color="#2622A04A"/>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Tag">4</CornerRadius>

    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Hero">24</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">20</CornerRadius>
    <Thickness x:Key="Space.Card">22,18,22,18</Thickness>
    <Thickness x:Key="Space.Hero">28,26,28,26</Thickness>
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Medium">0:0:0.22</Duration>
    <DropShadowEffect x:Key="Elevation.1" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black"/>
    <DropShadowEffect x:Key="Elevation.2" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.38" Color="Black"/>
    <DropShadowEffect x:Key="Glow.Accent" BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#F0B46A"/>


    <!-- ===== palette ===== -->
    <Color x:Key="BgColor">#141113</Color>
    <SolidColorBrush x:Key="Bg" Color="#141113"/>
    <SolidColorBrush x:Key="Panel" Color="#1B1618"/>   <!-- AndersCraft: opaque, so dialogs and popups keep their tone -->
    <SolidColorBrush x:Key="Panel2" Color="#1E191B"/>
    <SolidColorBrush x:Key="Input" Color="#110E10"/>
    <SolidColorBrush x:Key="Line" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="LineHi" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#CCF3E9E4"/>
    <SolidColorBrush x:Key="Muted" Color="#99F3E9E4"/>
    <SolidColorBrush x:Key="Faint" Color="#66F3E9E4"/>
    <SolidColorBrush x:Key="Maroon" Color="#8E2B3A"/>
    <SolidColorBrush x:Key="MaroonHi" Color="#A53547"/>
    <SolidColorBrush x:Key="MaroonDim" Color="#808A1C2B"/>
    <SolidColorBrush x:Key="Amber" Color="#F0B46A"/>
    <SolidColorBrush x:Key="AmberHi" Color="#F6C687"/>
    <SolidColorBrush x:Key="AmberDim" Color="#3B2C1A"/>
    <SolidColorBrush x:Key="AmberInk" Color="#24170D"/>
    <SolidColorBrush x:Key="OkBg" Color="#17301F"/>
    <SolidColorBrush x:Key="Ok" Color="#8FD6A6"/>
    <SolidColorBrush x:Key="BadBg" Color="#3A1519"/>
    <SolidColorBrush x:Key="Bad" Color="#F08A8A"/>
    <SolidColorBrush x:Key="Deep" Color="#40000000"/>
    <SolidColorBrush x:Key="Sel" Color="#8C8A1C2B"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ===== tooltip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#2A2124"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineHi}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MaxWidth" Value="380"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== buttons ===== -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Panel2}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="{StaticResource Radius.Pill}"/>
                        <Grid x:Name="focus" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"><Border BorderBrush="#F2FFFFFF" BorderThickness="2" CornerRadius="22"/><Border BorderBrush="#E6000000" BorderThickness="2" Margin="2" CornerRadius="22"/></Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Accent.Gradient}"/>
        <Setter Property="Foreground" Value="#FFF6F2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Pill}">
                            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="{StaticResource Glow.MaroonColor}"/></Border.Effect>
                        </Border>
                        <Border x:Name="shine" CornerRadius="{StaticResource Radius.Pill}" IsHitTestVisible="False" Visibility="{DynamicResource Shimmer.Visibility}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#00FFFFFF" Offset="0.3"/><GradientStop Color="#55FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="0.7"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" Duration="0:0:5.5">
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)" From="-1" To="1" BeginTime="0:0:2" Duration="0:0:1.4">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <Grid x:Name="focus" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"><Border BorderBrush="{StaticResource Text.Strong}" BorderThickness="2" CornerRadius="16"/><Border BorderBrush="{StaticResource Canvas.Deep}" BorderThickness="2" Margin="2" CornerRadius="14"/></Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.85" Color="{StaticResource Glow.MaroonColor}"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter TargetName="shine" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnAmber" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Amber.Gradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AmberHi}"/>
        <Setter Property="Foreground" Value="{StaticResource AmberInk}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="{StaticResource Radius.Pill}"/>
                        <Grid x:Name="focus" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"><Border BorderBrush="#F2FFFFFF" BorderThickness="2" CornerRadius="22"/><Border BorderBrush="#E6000000" BorderThickness="2" Margin="2" CornerRadius="22"/></Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AmberHi}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- nav item in the sidebar -->
    <Style x:Key="NavBtn" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="12,9,12,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="hover" Background="{StaticResource Bleed.Hover}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="pool" Background="{StaticResource Bleed.Rail}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="-6,4,0,4" CornerRadius="2" Background="{StaticResource Rail.Marker}" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource Glow.AccentStrong}"/>
                        <Border x:Name="bd" Background="Transparent"/>
                        <Grid x:Name="focus" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"><Border BorderBrush="{StaticResource Text.Strong}" BorderThickness="2" CornerRadius="16"/><Border BorderBrush="{StaticResource Canvas.Deep}" BorderThickness="2" Margin="2" CornerRadius="14"/></Grid>
                        <ContentPresenter x:Name="label" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{StaticResource Text.Strong}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Selected}"/>
                            <Setter TargetName="label" Property="Effect" Value="{StaticResource Glow.Text}"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="pool" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Medium}"/>
                                <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Medium}"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="pool" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}"/>
                                <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- segmented tab (RadioButton) -->
    <!-- a long workspace list (AndersCraft has twenty): the same nav, a little tighter -->
    <Style x:Key="NavBtn.Dense" TargetType="RadioButton" BasedOn="{StaticResource NavBtn}">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,7,12,7"/>
        <Setter Property="Margin" Value="0,1"/>
    </Style>
    <Style x:Key="SegBtn" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="2">
                        <Border x:Name="pool" Background="{StaticResource Bleed.Accent}" Opacity="0" IsHitTestVisible="False" Margin="-6,-4"/>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Radius.Pill}" Padding="14,7">
                            <ContentPresenter x:Name="label" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <Grid x:Name="focus" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"><Border BorderBrush="{StaticResource Text.Strong}" BorderThickness="2" CornerRadius="18"/><Border BorderBrush="{StaticResource Canvas.Deep}" BorderThickness="2" Margin="2" CornerRadius="16"/></Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bleed.Hover}"/><Setter Property="Foreground" Value="{StaticResource Text.Strong}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="pool" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{StaticResource Text.Selected}"/><Setter TargetName="label" Property="Effect" Value="{StaticResource Glow.Text}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- plain option radio (target picker) -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="card" Background="{StaticResource Panel2}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="16" Padding="14,12">
                        <DockPanel>
                            <Grid Width="18" Height="18" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,10,0">
                                <Ellipse x:Name="ring" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="dot" Fill="{StaticResource Amber}" Margin="4" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter RecognizesAccessKey="False"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="dot" Property="Visibility" Value="Visible"/><Setter TargetName="ring" Property="Stroke" Value="{StaticResource Amber}"/><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AmberHi}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== checkbox ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="6" BorderThickness="0" Background="{StaticResource Layer.10}" VerticalAlignment="Center">
                            <Path x:Name="tick" Data="M3,9 L7,13 L15,4" Stroke="{StaticResource AmberInk}" StrokeThickness="2.2" Visibility="Collapsed" Stretch="None" Margin="-0.5,-1,0,0"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="tick" Property="Visibility" Value="Visible"/><Setter TargetName="box" Property="Background" Value="{StaticResource Amber.Gradient}"/><Setter TargetName="box" Property="Effect" Value="{StaticResource Glow.Accent}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="{StaticResource Layer.15}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Text.Strong}"/><Setter TargetName="box" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== text inputs ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Layer.10}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CaretBrush" Value="{StaticResource Amber}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Maroon}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="glow" Background="{StaticResource Layer.10}" CornerRadius="{StaticResource Radius.Field}" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource Glow.Accent}"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="{StaticResource Radius.Field}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Layer.15}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="glow" Property="Opacity" Value="0.6"/><Setter TargetName="bd" Property="Background" Value="{StaticResource Layer.15}"/></Trigger>
                        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Layer.5}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Layer.10}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CaretBrush" Value="{StaticResource Amber}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Maroon}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="glow" Background="{StaticResource Layer.10}" CornerRadius="{StaticResource Radius.Field}" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource Glow.Accent}"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="{StaticResource Radius.Field}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Layer.15}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="glow" Property="Opacity" Value="0.6"/><Setter TargetName="bd" Property="Background" Value="{StaticResource Layer.15}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== scrollbars (thin) ===== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="#4A3B41" CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#6E5A62"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource Amber}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PageRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageRepeat}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" MinHeight="24"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageRepeat}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" Padding="2">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageRepeat}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" MinWidth="24"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageRepeat}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== list box ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1">
                        <Border Background="{StaticResource Layer.5}" CornerRadius="10" IsHitTestVisible="False"/>
                        <Border x:Name="hover" Background="{StaticResource Bleed.Hover}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="pool" Background="{StaticResource Bleed.Accent}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="10,6"><ContentPresenter/></Border>
                        <Grid x:Name="focus" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"><Border BorderBrush="{StaticResource Text.Strong}" BorderThickness="2" CornerRadius="12"/><Border BorderBrush="{StaticResource Canvas.Deep}" BorderThickness="2" Margin="2" CornerRadius="10"/></Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="pool" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{StaticResource Text.Selected}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== data grid ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Layer5}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="VerticalGridLinesBrush" Value="#262023"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
    </Style>
    <!-- data rows float: no grid lines, a faint zebra tone, brighter on hover -->
    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Layer10}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Layer10}"/>
        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Sel}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== combo box ===== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Input}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="{StaticResource Radius.Control}"/>
                        <ContentPresenter Margin="11,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None" VerticalOffset="4">
                            <Border Background="#241D20" BorderBrush="{StaticResource LineHi}" BorderThickness="1" CornerRadius="9" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource MaroonDim}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Amber}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== context menu ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#241D20"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineHi}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="12,7">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource MaroonDim}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<!-- ===== file tree ===== -->
    <Style x:Key="ExpandToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="arrow" Data="M4,2 L9,7 L4,12" Stroke="{StaticResource Muted}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="arrow" Property="Data" Value="M2,4 L7,9 L12,4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="bd" Background="Transparent" Padding="4,3,8,3" CornerRadius="5" Margin="4,0">
                            <DockPanel>
                                <ToggleButton x:Name="exp" Style="{StaticResource ExpandToggle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" DockPanel.Dock="Left" Margin="0,0,3,0"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ItemsPresenter x:Name="items" Margin="14,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False"><Setter TargetName="exp" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="items" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger SourceName="bd" Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Sel}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Line}"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <!-- ===== surfaces (tonal steps, darkest first) ===== -->
    <SolidColorBrush x:Key="Surface0" Color="#141113"/>
    <SolidColorBrush x:Key="Surface1" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Surface3" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Go" Color="#2F8F4E"/>
    <SolidColorBrush x:Key="GoHi" Color="#38A65B"/>

    <!-- ===== pill button: actions in the chrome and secondary actions ===== -->
    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Pill}"/>
                        <Border x:Name="hi" Background="#14FFFFFF" CornerRadius="{StaticResource Radius.Pill}" Opacity="0"/>
                        <Grid x:Name="focus" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"><Border BorderBrush="#F2FFFFFF" BorderThickness="2" CornerRadius="22"/><Border BorderBrush="#E6000000" BorderThickness="2" Margin="2" CornerRadius="22"/></Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hi" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hi" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Pill.Quiet" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="Pill.Go" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource Go.Gradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="26,14"/>
    </Style>

    <!-- ===== chip: small status labels ===== -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>
    <!-- ===== AndersCraft additions ===== -->
    <!-- a field you've changed but not applied: a warm amber tint instead of an outline -->
    <SolidColorBrush x:Key="Changed" Color="#3A2A1A"/>
    <!-- the crossed-swords crest -->
    <Color x:Key="Crest.HiColor">#A53547</Color>
    <Color x:Key="Crest.LoColor">#5E1A26</Color>
    <SolidColorBrush x:Key="Crest.Rim" Color="#F0B46A"/>
    <SolidColorBrush x:Key="Crest.Blade" Color="#F3E6D8"/>
    <SolidColorBrush x:Key="Crest.Edge" Color="#24170D"/>
    <!-- replicas of the game's own look, for previews of what the player sees (data colours, not the app's palette) -->
    <SolidColorBrush x:Key="Game.Tooltip" Color="#0B0B18"/>
    <SolidColorBrush x:Key="Game.TooltipEdge" Color="#5A5A6E"/>
    <SolidColorBrush x:Key="Game.Gold" Color="#FFD100"/>
    <SolidColorBrush x:Key="Game.White" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Game.Grey" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Parchment" Color="#E9DCBF"/>
    <SolidColorBrush x:Key="Parchment.Ink" Color="#3A2614"/>
    <SolidColorBrush x:Key="Parchment.Head" Color="#2A1606"/>
    <!-- the 3D viewer's stage -->
    <Color x:Key="Viewer.TopColor">#2A2424</Color>
    <Color x:Key="Viewer.BottomColor">#141112</Color>
    <SolidColorBrush x:Key="Marker.Ring" Color="#FFFFFF"/>
</ResourceDictionary>
