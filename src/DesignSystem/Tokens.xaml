<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
      Studio design tokens. Shared by every studio app: copy this file, change the Canvas and
      Accent values, and every style built on it follows.
      AndersCraft Studio's copy (from the suite's Tokens.xaml, same names): dark maroon canvas #141113 / #1B1618,
      amber accent #F0B46A, maroon-rose second accent. Studio's own design system (StudioDesignSystem.xaml) merges it.

      Rules:
        - Surfaces are translucent white LAYERS over the canvas, never fixed greys.
        - Text levels are opacities of one text colour.
        - No solid borders. Separate with layers and elevation; Divider (8%) only where needed.
    -->

    <!-- Base colours -->
    <Color x:Key="Color.Canvas">#141113</Color>
    <Color x:Key="Color.CanvasDeep">#0E0B0D</Color>
    <Color x:Key="Color.Raised">#1B1618</Color>
    <Color x:Key="Color.Text">#F3E9E4</Color>
    <Color x:Key="Color.Accent">#F0B46A</Color>
    <Color x:Key="Color.AccentWarm">#E0974A</Color>
    <Color x:Key="Color.AccentPink">#C24A5C</Color>
    <Color x:Key="Color.AccentInk">#24170D</Color>
    <Color x:Key="Color.Danger">#F08A8A</Color>
    <Color x:Key="Color.Success">#8FD6A6</Color>

    <SolidColorBrush x:Key="Canvas" Color="{StaticResource Color.Canvas}"/>
    <SolidColorBrush x:Key="Canvas.Deep" Color="{StaticResource Color.CanvasDeep}"/>
    <SolidColorBrush x:Key="Raised" Color="{StaticResource Color.Raised}"/>

    <!-- Translucent surface layers (white over canvas) -->
    <SolidColorBrush x:Key="Layer.3" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="Layer.5" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Layer.8" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Layer.10" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Layer.15" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Layer.20" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Layer.40" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#14FFFFFF"/>

    <!-- Text opacities -->
    <SolidColorBrush x:Key="Text.Strong" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#CCF3E9E4"/>   <!-- 80% -->
    <SolidColorBrush x:Key="Text.Secondary" Color="#99F3E9E4"/> <!-- 60% -->
    <SolidColorBrush x:Key="Text.Disabled" Color="#66F3E9E4"/>  <!-- 40% -->
    <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Color.AccentInk}"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Accent.Pink" Color="{StaticResource Color.AccentPink}"/>
    <SolidColorBrush x:Key="Accent.Tint" Color="#33F0B46A"/>
    <SolidColorBrush x:Key="Accent.PinkTint" Color="#33C24A5C"/>
    <SolidColorBrush x:Key="Accent.Dim" Color="#7A5A30"/>
    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F6C687" Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentWarm}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Accent.GradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FAD6A6" Offset="0"/>
        <GradientStop Color="#E8A55C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Accent.Sunset" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0B46A" Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentPink}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Status.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Status.Success" Color="{StaticResource Color.Success}"/>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Field">12</CornerRadius>
    <CornerRadius x:Key="Radius.Tag">4</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Spacing (4 px scale) -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">20</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>
    <Thickness x:Key="Pad.Card">18</Thickness>
    <Thickness x:Key="Pad.Control">16,9</Thickness>
    <Thickness x:Key="Pad.Field">10,8</Thickness>
    <Thickness x:Key="Pad.Tag">6,2</Thickness>

    <!-- Elevation (soft shadows) -->
    <DropShadowEffect x:Key="Shadow.1" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000"/>
    <DropShadowEffect x:Key="Shadow.2" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="Glow.Accent" BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="{StaticResource Color.Accent}"/>
    <DropShadowEffect x:Key="Glow.Pink" BlurRadius="16" ShadowDepth="0" Opacity="0.5" Color="{StaticResource Color.AccentPink}"/>
    <DropShadowEffect x:Key="Glow.AccentSoft" BlurRadius="22" ShadowDepth="0" Opacity="0.35" Color="{StaticResource Color.Accent}"/>
    <DropShadowEffect x:Key="Glow.AccentStrong" BlurRadius="30" ShadowDepth="0" Opacity="0.85" Color="{StaticResource Color.Accent}"/>
    <!-- Cards float in a faint warm halo instead of a hard shadow -->
    <DropShadowEffect x:Key="Glow.Card" BlurRadius="44" ShadowDepth="0" Opacity="0.34" Color="#A53547"/>
    <DropShadowEffect x:Key="Glow.Text" BlurRadius="14" ShadowDepth="0" Opacity="0.75" Color="{StaticResource Color.Accent}"/>
    <DropShadowEffect x:Key="Glow.Title" BlurRadius="26" ShadowDepth="0" Opacity="0.85" Color="#E8A06A"/>
    <!-- Titles: warm gold into rose, like light through glass -->
    <LinearGradientBrush x:Key="Text.Magic" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFE9C8" Offset="0"/>
        <GradientStop Color="#F6C687" Offset="0.45"/>
        <GradientStop Color="#D8687A" Offset="1"/>
    </LinearGradientBrush>
    <!-- Bleeds: selection and hover light that fades out to nothing at the edges (no visible box) -->
    <RadialGradientBrush x:Key="Bleed.Accent" RadiusX="0.62" RadiusY="0.95" Center="0.5,0.5" GradientOrigin="0.5,0.5">
        <GradientStop Color="#70F0B46A" Offset="0"/>
        <GradientStop Color="#38C24A5C" Offset="0.55"/>
        <GradientStop Color="#00C24A5C" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Bleed.AccentSoft" RadiusX="0.62" RadiusY="0.95" Center="0.5,0.5" GradientOrigin="0.5,0.5">
        <GradientStop Color="#40F0B46A" Offset="0"/>
        <GradientStop Color="#1AC24A5C" Offset="0.6"/>
        <GradientStop Color="#00C24A5C" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Bleed.Hover" RadiusX="0.62" RadiusY="0.95" Center="0.5,0.5" GradientOrigin="0.5,0.5">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.6"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <!-- Left-rail selection: light pooling from the left edge -->
    <RadialGradientBrush x:Key="Bleed.Rail" RadiusX="1.0" RadiusY="0.75" Center="0,0.5" GradientOrigin="0,0.5">
        <GradientStop Color="#80F0B46A" Offset="0"/>
        <GradientStop Color="#30C24A5C" Offset="0.55"/>
        <GradientStop Color="#00C24A5C" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Rail.Marker" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00F6C687" Offset="0"/>
        <GradientStop Color="#FFF6C687" Offset="0.5"/>
        <GradientStop Color="#00F6C687" Offset="1"/>
    </LinearGradientBrush>

    <!-- A soft band of light that sweeps across primary buttons -->
    <LinearGradientBrush x:Key="Shimmer" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Ethereal surfaces: translucent so the ambient light shows through, with a soft top sheen -->
    <LinearGradientBrush x:Key="Card.Glass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C2261A1E" Offset="0"/>
        <GradientStop Color="#B31E1619" Offset="0.35"/>
        <GradientStop Color="#A6171214" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Card.Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFE6CC" Offset="0"/>
        <GradientStop Color="#00FFE6CC" Offset="0.3"/>
    </LinearGradientBrush>
    <Color x:Key="Color.Plum">#7A2E6B</Color>

    <!-- the card surface in one brush: glass with its top sheen -->
    <DrawingBrush x:Key="Card.Surface" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Card.Glass}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Card.Sheen}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="Text.Selected" Color="#FFE9C8"/>

    <!-- Motion (ms, for code-behind animations) -->
    <sys:Double x:Key="Motion.Fast">120</sys:Double>
    <sys:Double x:Key="Motion.Base">180</sys:Double>
    <sys:Double x:Key="Motion.Slow">280</sys:Double>

    <!-- Double-ring keyboard focus: light outer ring, dark inner ring, visible on any surface -->
    <Style x:Key="Focus.DoubleRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-4">
                        <Border BorderBrush="{StaticResource Text.Strong}" BorderThickness="2" CornerRadius="14"/>
                        <Border BorderBrush="{StaticResource Canvas.Deep}" BorderThickness="2" CornerRadius="12" Margin="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

